generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Jogador {
  id         Int         @id @default(autoincrement())
  nome       String
  email      String      @unique
  avaliacoes Avaliacao[]
}

model Avaliacao {
  id         Int     @id @default(autoincrement())
  jogo       String
  nota       Int
  comentario String
  jogadorId  Int
  jogador    Jogador @relation(fields: [jogadorId], references: [id])
}
